# Enclavia Nitro Enclave kernel policy.
#
# This is deliberately a KCONFIG_ALLCONFIG seed, not a copied distribution
# .config.  nix/kernel-config.nix applies it with `make allnoconfig`, validates
# every requested setting, and emits the complete version-specific .config.
# Keep common Nitro/OCI capabilities here; storage-only block, crypto and
# filesystem support belongs in enclave-storage-kernel.config.

# x86-64 Nitro/KVM guest and boot path
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=128
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_X86_MPPARSE=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# 16 MiB kernel alignment, matching the retired 4.14 blob.  The Nitro
# enclave firmware derives the initrd load address from the bzImage
# header as roughly `base + init_size + (kernel_alignment - 2 MiB)`,
# while the kernel's boot stub relocates the compressed payload to the
# top of its extraction window `[pref_address, pref_address+init_size)`
# before decompressing.  With the default 2 MiB alignment the firmware
# places the initrd ~10 MiB INSIDE that window, so the stub's payload
# copy overwrites the initrd at a constant ~8.6 MiB stream offset and
# any EIF whose concatenated ramdisks exceed that unpacks corrupt on
# real Nitro ("Initramfs unpacking failed: uncompression error"; QEMU
# is unaffected because SeaBIOS loads the initrd high).  16 MiB
# alignment shifts the firmware's initrd placement above the window
# with a constant positive margin, independent of kernel or initrd
# growth.  Verified empirically on real Nitro hardware (i.e. this is
# load-bearing, do not drop when rebasing the config).
CONFIG_PHYSICAL_ALIGN=0x1000000

# Keep CPU vulnerability defenses, without call-depth tracking's ~5% text
# growth.  These symbols are checked against the pinned kernel so a rename or
# dependency change fails the config derivation instead of silently weakening
# the image.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set
# CONFIG_CALL_THUNKS_DEBUG is not set
# CONFIG_MITIGATION_SLS is not set

# Small production kernel
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_BASE_SMALL=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_SLUB=y
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_250=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_UNWINDER_GUESS=y
# Linux 7.1's x86 and EXPERT Kconfig paths require these umbrella symbols.
# Concrete profiling, tracing, and debug facilities remain disabled below.
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_KERNEL=y

# Linux userspace ABI used by Go, Rust/Tokio, glibc/musl and crun
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSCTL=y

# External gzip-compressed EIF ramdisks.  KERNEL_XZ above compresses bzImage;
# it does not enable the XZ initramfs decompressor.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y

# Filesystems and process isolation used by the init and OCI runtime
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y

# Console and devpts are fatal-mount dependencies of init-patched
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1

# Nitro devices: NSM and AF_VSOCK are virtio-mmio command-line devices
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NSM=y

# IPv4-only application/egress path.  The isolated resolver needs TUN, veth
# and NET_NS.  One legacy iptables OUTPUT rule needs only the filter table.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
# allnoconfig suppresses NET_CORE's default-y value; TUN and veth sit behind it.
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
# The filter table is nested under IP_NF_IPTABLES and uses the legacy evaluator.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y

# Retained exploit mitigations; heavyweight LSMs and debug sanitizers below
# remain disabled.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_LIST_HARDENED=y

# Global exclusions.  The generator checks that none resolves to y or m.
# CONFIG_MODULES is not set
# CONFIG_AUDIT is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KALLSYMS is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_STACKTRACE is not set
# CONFIG_UNWINDER_ORC is not set
# CONFIG_UNWINDER_FRAME_POINTER is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_IKCONFIG is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KCOV is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TASKSTATS is not set
# CONFIG_PSI is not set
# CONFIG_IO_URING is not set
# CONFIG_AIO is not set
# CONFIG_COREDUMP is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set

# CONFIG_SECURITY is not set
