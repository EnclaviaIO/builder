# Enclavia Nitro Enclave kernel policy, aarch64 (Graviton).
#
# The aarch64 counterpart of enclave-kernel.config, with the same role: a
# KCONFIG_ALLCONFIG seed that nix/kernel-config.nix applies with
# `make ARCH=arm64 CROSS_COMPILE=... allnoconfig`, validates request by
# request, and turns into the complete version-specific .config.
#
# Sections without an "arm64:" note are the architecture-neutral policy and
# must stay in sync with enclave-kernel.config.  There is no aarch64 storage
# profile; the only aarch64 consumer is the synchronizer EIF.

# arm64: Nitro/KVM guest and boot path.  ARM64 itself selects OF, ARM_AMBA,
# ARM_ARCH_TIMER, ARM_GIC(_V3), ARM_PSCI_FW, SWIOTLB, IRQ_DOMAIN and SMP.
# The enclave firmware boots an uncompressed arm64 Image, so there is no
# KERNEL_XZ and no bzImage PHYSICAL_ALIGN/initrd placement constraint.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=128
CONFIG_ARM64_4K_PAGES=y
# 48-bit virtual and physical addresses.  52-bit VA with 4K pages needs
# FEAT_LPA2, which Graviton does not implement, so the kernel would fall back
# to 48 bits at runtime anyway while carrying the LPA2 page-table code.  It
# would also shrink the pointer-authentication code from 7 to 3 bits
# (arch/arm64/Kconfig, ARM64_VA_BITS_52).  48 bits gives 256 TiB of VA, far
# beyond any enclave's memory.
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_PA_BITS=48
# CONFIG_ARM64_PA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# arm64: CPU vulnerability defenses and hardware hardening, in place of the
# x86 MITIGATION_* block.  Graviton3 is Neoverse-V1, Graviton4 Neoverse-V2.
CONFIG_CPU_MITIGATIONS=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
# ARM64_BTI_KERNEL depends on !CC_IS_GCC (GCC bug 106671), so a GCC-built
# kernel gets BTI for userspace only.  Full rodata is unconditional in 7.1.
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_EPAN=y
# Neoverse-V1/V2 errata.  These are default-y upstream, and allnoconfig would
# otherwise drop them.
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_ERRATUM_4118414=y

# Small production kernel
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_BASE_SMALL=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB=y
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_250=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Linux userspace ABI used by Go, Rust/Tokio, glibc/musl and crun
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSCTL=y

# External gzip-compressed EIF ramdisks.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y

# Filesystems and process isolation used by the init and OCI runtime
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y

# Console and devpts are fatal-mount dependencies of init-patched.
# arm64: the 8250 UART is a device-tree node, not a legacy I/O port, so it
# needs the OF platform glue.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y

# Nitro devices: NSM and AF_VSOCK are virtio-mmio devices.
# arm64: they are device-tree nodes; the firmware passes no
# virtio_mmio.device= kernel arguments.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NSM=y

# IPv4-only application/egress path.  The isolated resolver needs TUN, veth
# and NET_NS.  One legacy iptables OUTPUT rule needs only the filter table.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
# allnoconfig suppresses NET_CORE's default-y value; TUN and veth sit behind it.
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
# The filter table is nested under IP_NF_IPTABLES and uses the legacy evaluator.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y

# Retained exploit mitigations; heavyweight LSMs and debug sanitizers below
# remain disabled.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_LIST_HARDENED=y

# arm64: wall clock.  x86 enclaves read wall time from kvm-clock; arm64 KVM
# has no paravirtual wall clock.  The Nitro arm64 device tree exposes a PL031
# RTC, and without it the enclave boots at 1970 and X.509 validity checks
# fail.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# arm64: the enclave firmware describes all devices with a device tree.  It
# provides no ACPI tables and no UEFI.
# CONFIG_EFI is not set
# CONFIG_ACPI is not set

# Global exclusions.  The generator checks that none resolves to y or m.
# CONFIG_MODULES is not set
# CONFIG_AUDIT is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KALLSYMS is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_STACKTRACE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_IKCONFIG is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KCOV is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TASKSTATS is not set
# CONFIG_PSI is not set
# CONFIG_IO_URING is not set
# CONFIG_AIO is not set
# CONFIG_COREDUMP is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set

# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_LANDLOCK is not set
# CONFIG_INTEGRITY is not set
# CONFIG_KEYS is not set

# CONFIG_IPV6 is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES_LEGACY is not set
# CONFIG_IP6_NF_FILTER is not set
# CONFIG_IP6_NF_MANGLE is not set
# CONFIG_IP6_NF_RAW is not set
# CONFIG_IP6_NF_SECURITY is not set
# CONFIG_IP6_NF_NAT is not set
# CONFIG_NF_TABLES is not set
# CONFIG_NF_CONNTRACK is not set
# CONFIG_NF_NAT is not set
# CONFIG_IP_NF_NAT is not set
# CONFIG_IP_NF_MANGLE is not set
# CONFIG_IP_NF_RAW is not set
# CONFIG_IP_NF_SECURITY is not set
# CONFIG_IP_NF_TARGET_REJECT is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_PACKET is not set
# CONFIG_INET_DIAG is not set
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
# CONFIG_VIRTIO_NET is not set

# CONFIG_EXT4_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_VFAT_FS is not set

# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# CONFIG_PCI is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_SCSI is not set
# CONFIG_NVME_CORE is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_VT is not set
# CONFIG_DEVMEM is not set
# CONFIG_KVM is not set
# arm64: the 32-bit (AArch32) userspace ABI, counterpart of IA32_EMULATION.
# CONFIG_COMPAT is not set
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_UTS_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_TIME_NS is not set
