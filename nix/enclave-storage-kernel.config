# Storage-only additions to enclave-kernel.config.  This fragment is applied
# only to enclave-storage* targets.

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NBD=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y

# LUKS2 uses AES-XTS.  Keep the generic AES implementation so the image works
# even when the hypervisor masks AES-NI; avoid unrelated crypto algorithms and
# user APIs.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y

# The single persistent filesystem.  POSIX ACLs preserve normal container
# data-volume permission semantics.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_DM_DEBUG is not set
# CONFIG_DM_INIT is not set
# CONFIG_BTRFS_FS_RUN_SANITY_TESTS is not set
# CONFIG_BTRFS_DEBUG is not set
# CONFIG_BTRFS_ASSERT is not set
# CONFIG_CRYPTO_SELFTESTS is not set
# CONFIG_CRYPTO_USER_API is not set
# CONFIG_CRYPTO_AES_NI_INTEL is not set
